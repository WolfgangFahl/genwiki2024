#!/bin/bash
# WF 2025-05-25
# run a GOV SPARQL Query

# Check if query name is provided
if [ -z "$1" ]; then
   echo "Usage: $0 <query_name> [params] [additional_options...]"
   echo "Example: $0 SearchByPattern 'pattern=Berlin,limit=10'"
   exit 1
fi

cd genwiki_examples || exit 2

args=(-en gov -ep gov-ep.yaml --prefixes -qp gov-queries.yaml)

added=0
for arg in "$@"; do
  case "$arg" in
    -*) break ;;  # alle Optionen (auch -h, -f, --list)
    *)
      if (( added == 0 )); then
        args+=(-qn "$arg")
      elif (( added == 1 )); then
        args+=(--params "$arg")
      fi
      added=$((added + 1))
      shift
      ;;
  esac
done

args+=("$@")
sparqlquery "${args[@]}"
